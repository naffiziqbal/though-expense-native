# Base URL of the ThoughtExpense backend (server/ in this repo, default port 7100).
# For a physical device on the same network, use your machine's LAN IP, e.g. http://192.168.0.10:7100
# For Android emulator use http://10.0.2.2:7100
EXPO_PUBLIC_API_URL=http://localhost:7100
# Public CDN base for profile pictures (DigitalOcean Spaces)
EXPO_PUBLIC_SPACES_URL=https://nexustorage.sgp1.digitaloceanspaces.com
