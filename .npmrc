# Do not add pnpm-workspace.yaml here — EAS treats that as a monorepo and
# runs install from the wrong directory.
minimum-release-age=0
# Gradle's Sentry task looks for node_modules/@sentry/cli/bin/sentry-cli.
# pnpm otherwise leaves it nested under .pnpm and the process cannot start.
public-hoist-pattern[]=@sentry/cli
public-hoist-pattern[]=@sentry/cli-*
